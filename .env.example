# Database
DATABASE_URL=postgresql://user:password@localhost:5432/stripe_workshops

# Stripe platform keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# SA authentication
INSTRUCTOR_PASSWORD=your-secure-password-here
BETTER_AUTH_SECRET=a-random-256-bit-secret

# Cron job protection (required in production)
CRON_SECRET=a-random-secret-for-vercel-cron

# ---------------------------------------------------------------------------
# View-Dashboard-As (VDA) "Open Dashboard" links
# All NEXT_PUBLIC_* values are inlined into the browser bundle. These are public
# Stripe account IDs (acct_...), not secrets. Set them in Vercel env vars.
# ---------------------------------------------------------------------------

# The workshop platform's own Stripe account ID (viewers must be logged into it)
NEXT_PUBLIC_STRIPE_PLATFORM_ACCOUNT_ID=acct_TODO

# Pre-created connected account IDs per workshop theme (test mode)
NEXT_PUBLIC_WORKSHOP_ACCOUNT_FRAUD=acct_TODO
NEXT_PUBLIC_WORKSHOP_ACCOUNT_PAYMENTS=acct_TODO
NEXT_PUBLIC_WORKSHOP_ACCOUNT_BILLING=acct_TODO
NEXT_PUBLIC_WORKSHOP_ACCOUNT_CONNECT=acct_TODO
NEXT_PUBLIC_WORKSHOP_ACCOUNT_DISPUTES=acct_TODO

# Shared workshop Stripe login shown in the auth pre-flight modal.
# Only set the password if this is a throwaway test-only account; otherwise
# leave it blank and have facilitators share it out of band.
NEXT_PUBLIC_WORKSHOP_STRIPE_EMAIL=
NEXT_PUBLIC_WORKSHOP_STRIPE_PASSWORD=

# Optional: Vercel Analytics
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=...
